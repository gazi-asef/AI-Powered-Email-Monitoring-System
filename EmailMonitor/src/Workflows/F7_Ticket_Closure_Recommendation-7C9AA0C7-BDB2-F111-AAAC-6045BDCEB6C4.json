      "triggers": {
        "manual": {
          "metadata": {
            "operationMetadataId": "b3b75082-54ad-40ca-8e29-7e29601e5cf0"
          },
          "type": "Request",
          "kind": "PowerAppV2",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "text": {
                  "description": "Please enter your input",
                  "title": "TicketId",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "text_1": {
                  "description": "Please enter your input",
                  "title": "SupportRemark",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "text_2": {
                  "description": "Please enter your input",
                  "title": "TicketConversation",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
